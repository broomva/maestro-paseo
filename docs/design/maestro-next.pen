        {
          "type": "frame",
          "id": "YJWPk",
          "name": "recommendation",
          "width": "fill_container",
          "fill": "$bg",
          "cornerRadius": 16,
          "stroke": "#0072A359",
          "strokeWidth": 1.5,
          "layout": "vertical",
          "gap": 10,
          "padding": [
            18,
            22
          ],
          "children": [
            {
              "type": "text",
              "id": "O4951",
              "name": "t",
              "fill": "$fg",
              "content": "My recommendation for M1: M1b's tab bar, with M1c's deck at the top of the Feed",
              "lineHeight": 1.45,
              "fontFamily": "$font-ui",
              "fontSize": 16,
              "fontWeight": "600"
            },
            {
              "type": "frame",
              "id": "qLw9F",
              "name": "pt",
              "width": "fill_container",
              "gap": 8,
              "children": [
                {
                  "type": "icon",
                  "id": "VsERA",
                  "name": "i",
                  "width": 14,
                  "height": 14,
                  "icon": "corner-down-right",
                  "library": "lucide",
                  "fill": "$needs"
                },
                {
                  "type": "text",
                  "id": "G0fq4F",
                  "name": "t",
                  "fill": "$fg-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Navigation from M1b: four tabs and New work at the bottom, a large title with the verdict line on every tab. It mirrors J1's tabs, so desktop and phone share one map.",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-ui",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "ZNa8x",
              "name": "pt",
              "width": "fill_container",
              "gap": 8,
              "children": [
                {
                  "type": "icon",
                  "id": "A3ZoA",
                  "name": "i",
                  "width": 14,
                  "height": 14,
                  "icon": "corner-down-right",
                  "library": "lucide",
                  "fill": "$needs"
                },
                {
                  "type": "text",
                  "id": "K98j9",
                  "name": "t",
                  "fill": "$fg-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "When something needs you, the Feed tab opens on M1c's deck: the most blocking hold, full width, verbs at the thumb, swipe for the next. With nothing held, the deck folds away and the Feed is M1b's tiles and rows.",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-ui",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "WYIfh",
              "name": "pt",
              "width": "fill_container",
              "gap": 8,
              "children": [
                {
                  "type": "icon",
                  "id": "x8yp7t",
                  "name": "i",
                  "width": 14,
                  "height": 14,
                  "icon": "corner-down-right",
                  "library": "lucide",
                  "fill": "$needs"
                },
                {
                  "type": "text",
                  "id": "LbnNw",
                  "name": "t",
                  "fill": "$fg-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "From M1d, only the row verbs for watched items (Continue, Done). No swipe-to-allow: approvals stay a deliberate tap with the 8 s undo.",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-ui",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "SzPMF",
              "name": "pt",
              "width": "fill_container",
              "gap": 8,
              "children": [
                {
                  "type": "icon",
                  "id": "iwnVB",
                  "name": "i",
                  "width": 14,
                  "height": 14,
                  "icon": "corner-down-right",
                  "library": "lucide",
                  "fill": "$needs"
                },
                {
                  "type": "text",
                  "id": "Uop46",
                  "name": "t",
                  "fill": "$fg-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "From M1a, nothing structural; its pushed inspector page is the one every variation already uses.",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-ui",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
