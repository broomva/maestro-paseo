                  "fontFamily": "$font-ui",
                  "fontSize": 13
                },
                {
                  "type": "text",
                  "id": "jQb13",
                  "name": "t",
                  "fill": "$fg-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "2  Cards and verbs on broomva tokens with springs, inline expansion and the in-screen Undo capsule (with BRO-2999).",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-ui",
                  "fontSize": 13
                },
                {
                  "type": "text",
                  "id": "Y9QGBg",
                  "name": "t",
                  "fill": "$fg-2",
                  "textGrowth": "fixed-width",
