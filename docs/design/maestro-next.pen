              "fill": "$bg",
              "cornerRadius": 12,
              "stroke": "$border",
              "strokeWidth": 1,
              "layout": "vertical",
              "gap": 6,
              "padding": 18,
              "children": [
                {
                  "type": "text",
                  "id": "N5aJ59",
                  "name": "t",
                  "fill": "$fg",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Selection, not navigation",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-ui",
                  "fontSize": 15,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "nDZBa",
                  "name": "t",
                  "fill": "$fg-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The card you opened stays lit in the stream (Tidepool, 2 px), so you never lose your place. J and K walk the holds while the inspector stays open; the rail comes back when it closes. Desktop only: on the phone, the inspector is a pushed page.",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-ui",
                  "fontSize": 13
                }
              ]
            },
            {
              "type": "frame",
              "id": "MCbRq",
              "name": "From Apple",
              "width": "fill_container",
              "fill": "$bg",
              "cornerRadius": 12,
              "stroke": "$border",
              "strokeWidth": 1,
              "layout": "vertical",
              "gap": 6,
              "padding": 18,
              "children": [
                {
                  "type": "text",
                  "id": "zDlo4",
                  "name": "t",
                  "fill": "$fg",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Built from what a plugin has",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-ui",
                  "fontSize": 15,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "mLrg6",
                  "name": "t",
                  "fill": "$fg-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The inspector is a View inside Maestro's screen, sliding with Animated.spring. The frosted action bar uses backdropFilter on desktop and a solid fill on iOS. Keys work while Maestro has focus. Nothing here needs a host API Paseo lacks.",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-ui",
                  "fontSize": 13
                }
              ]
            },
            {
              "type": "frame",
              "id": "sfER8",
              "name": "From Liquid Glass, restrained",
              "width": "fill_container",
              "fill": "$bg",
              "cornerRadius": 12,
              "stroke": "$border",
              "strokeWidth": 1,
              "layout": "vertical",
              "gap": 6,
              "padding": 18,
              "children": [
                {
                  "type": "text",
                  "id": "IXE9Q",
                  "name": "t",
                  "fill": "$fg",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "What it costs",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-ui",
                  "fontSize": 15,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "M9ny6",
                  "name": "t",
                  "fill": "$fg-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "One selection state in the Feed, the inspector component (a superset of today's gate card), and the four glance tiles. The Finished and Health rows reuse the card's verbs. Undo stays our own capsule.",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-ui",
                  "fontSize": 13
                }
              ]
            }
          ]
        }
      ]
    }
