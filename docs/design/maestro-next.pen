              "layout": "vertical",
              "gap": 6,
              "padding": 18,
              "children": [
                {
                  "type": "text",
                  "id": "m7vPeX",
                  "name": "t",
                  "fill": "$fg",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Glance strip",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-ui",
                  "fontSize": 15,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "MqrA2",
                  "name": "t",
                  "fill": "$fg-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Needs you, Running, Handled today and Unsupervised, each a tile with a number, a line of context and a tap target (it filters the Feed). It replaces S1's Today block, which sat below the fold in the rail. All four are plain Views: buildable today.",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-ui",
                  "fontSize": 13
                }
              ]
            },
            {
              "type": "frame",
              "id": "wCIpk",
              "name": "From Apple",
              "width": "fill_container",
              "fill": "$bg",
              "cornerRadius": 12,
              "stroke": "$border",
              "strokeWidth": 1,
              "layout": "vertical",
              "gap": 6,
              "padding": 18,
              "children": [
                {
                  "type": "text",
                  "id": "n5VhM2",
                  "name": "t",
                  "fill": "$fg",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Full for holds, compact for watching",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-ui",
                  "fontSize": 15,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "X2ai5T",
                  "name": "t",
                  "fill": "$fg-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Approvals and owner steps keep S1's four rows. Finished and Health become two-line rows with their verbs on the right. Notices, Running and Queued sit in grouped lists with hairline dividers, the way iOS Settings groups rows.",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-ui",
                  "fontSize": 13
                }
              ]
            },
            {
              "type": "frame",
              "id": "gpIt8",
              "name": "From Liquid Glass, restrained",
              "width": "fill_container",
              "fill": "$bg",
              "cornerRadius": 12,
              "stroke": "$border",
              "strokeWidth": 1,
              "layout": "vertical",
              "gap": 6,
              "padding": 18,
              "children": [
                {
                  "type": "text",
                  "id": "O1KIdm",
                  "name": "t",
                  "fill": "$fg",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Trade-off",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-ui",
                  "fontSize": 15,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "I9Jrz",
                  "name": "t",
                  "fill": "$fg-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The strip costs about 130 px above the first hold. If the holds must always be the first thing on screen, the strip collapses into a one-line summary once you scroll (an Animated height, buildable).",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-ui",
                  "fontSize": 13
                }
              ]
            }
          ]
        }
