              "gap": 6,
              "padding": 18,
              "children": [
                {
                  "type": "text",
                  "id": "zDlo4",
                  "name": "t",
                  "fill": "$fg",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Built from what a plugin has",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-ui",
                  "fontSize": 15,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "mLrg6",
                  "name": "t",
                  "fill": "$fg-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The inspector is a View inside Maestro's screen, sliding with Animated.spring. The frosted action bar uses backdropFilter on desktop and a solid fill on iOS. Keys work while Maestro has focus. Nothing here needs a host API Paseo lacks.",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-ui",
                  "fontSize": 13
                }
              ]
            },
