          "children": [
            {
              "type": "text",
              "id": "BbeOe",
              "name": "t",
              "fill": "#FFFFFF",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "A middle path",
              "lineHeight": 1.45,
              "fontFamily": "Inter",
              "fontSize": 16,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "RvLlU",
              "name": "t",
              "fill": "#FFFFFFCC",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Keep broomva-design as the brand inside Paseo, and adopt the Liquid Glass behaviors that are not material:\n- sheets that grow from their card;\n- springs with velocity handoff;\n- a floating New work button;\n- presence and lanes in a sidebar;\n- push actions once Paseo has categories.\n\nGo full glass only for a native Maestro app (SwiftUI), where the material is free and expected.",
              "lineHeight": 1.45,
              "fontFamily": "Inter",
              "fontSize": 14
            }
          ]
        }
      ]
