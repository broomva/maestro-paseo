                  "fontSize": 13
                },
                {
                  "type": "text",
                  "id": "p9aZq",
                  "name": "t",
                  "fill": "$fg-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "4  Frost toolbar on desktop only, behind a Platform.OS check, with the solid fallback as the default.",
