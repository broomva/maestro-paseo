                {
                  "type": "text",
                  "id": "Y0TVy",
                  "name": "t",
                  "fill": "$fg-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "V2 keeps S1's dashboard (stream plus rail) and adds the glance strip, so the home answers \"how is it going\" before any card, and the watched kinds take a line each instead of a card.",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-ui",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "LF0C0",
              "name": "pt",
