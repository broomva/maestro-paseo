                  "height": 14,
                  "icon": "corner-down-right",
                  "library": "lucide",
                  "fill": "$needs"
                },
                {
                  "type": "text",
                  "id": "PuaW5",
                  "name": "t",
                  "fill": "$fg-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Clicking a card in V2 opens V3's inspector as a side panel over the rail, not a new page: evidence tiles, what happens after you act, the session and the history. Esc or a swipe closes it along the path it came from.",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-ui",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "NN7Fm",
              "name": "pt",
              "width": "fill_container",
              "gap": 8,
              "children": [
                {
                  "type": "icon",
                  "id": "KG8BB",
                  "name": "i",
                  "width": 14,
                  "height": 14,
                  "icon": "corner-down-right",
                  "library": "lucide",
                  "fill": "$needs"
                },
                {
                  "type": "text",
                  "id": "m537ru",
                  "name": "t",
                  "fill": "$fg-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "From Apple, keep only what is buildable and earns its place: the frosted toolbar (web only, solid on iOS), springs for in-place growth (Animated), the undo capsule (our own, since useToast has no action), press on pointer-down, and grouped lists with hairlines.",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-ui",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "niadg",
              "name": "pt",
              "width": "fill_container",
              "gap": 8,
