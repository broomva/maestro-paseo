                  "fontFamily": "$font-ui",
                  "fontSize": 15,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "Kqrex",
                  "name": "t",
                  "fill": "$fg-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "S9's sheet floated in the middle of nothing; J9 grows from the button you pressed (scale and position from its origin, a spring, back into the button on close) and dims the Feed instead of hiding it. A fifth row says who starts the work, the lane, so the composer never implies that Maestro launches sessions (A8).",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-ui",
                  "fontSize": 13
                }
              ]
