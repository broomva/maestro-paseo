                {
                  "type": "text",
                  "id": "NLGcp",
                  "name": "t",
                  "fill": "$fg-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "One grouped list of everything, with the safe verb on each row. The title (Feed ▾) is the section menu. Filter chips scroll under a one-line summary. A toolbar at the bottom holds the filter, the count, and New work. Swipe right for the default verb, left for Snooze or Open.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "MfAep",
              "name": "Strengths",
              "width": "fill_container",
              "fill": "$bg",
              "cornerRadius": 12,
              "stroke": "$border",
              "strokeWidth": 1,
              "layout": "vertical",
              "gap": 8,
              "padding": [
                16,
                18
              ],
              "children": [
                {
                  "type": "text",
                  "id": "FS081",
                  "name": "t",
                  "fill": "$fg",
                  "content": "Strengths",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-ui",
                  "fontSize": 15,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "gOA2S",
                  "name": "t",
                  "fill": "$fg-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The densest phone screen: about ten items on the first screen with no tiles. Most items never open: Done, Continue, Keep off and Allow are on the row or the swipe. It keeps J1's rule that a hold you need to read opens as a page.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "Zbu59",
              "name": "Costs and build",
              "width": "fill_container",
              "fill": "$bg",
              "cornerRadius": 12,
              "stroke": "$border",
              "strokeWidth": 1,
              "layout": "vertical",
              "gap": 8,
              "padding": [
                16,
                18
              ],
              "children": [
                {
                  "type": "text",
                  "id": "kYIHv",
                  "name": "t",
                  "fill": "$fg",
                  "content": "Costs and build",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-ui",
                  "fontSize": 15,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "DgBFT",
                  "name": "t",
                  "fill": "$fg-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "A swipe can allow a merge by accident; the 8 s undo is the only guard, so a swipe should never carry an irreversible verb. Swipes are hidden until learned. No glance tiles: \"how is it going\" shrinks to one grey line. Build: rows moved by PanResponder with a threshold and spring-back; the toolbar is an absolute View.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        }
      ]
    },
