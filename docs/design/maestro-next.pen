              "strokeWidth": 1,
              "layout": "vertical",
              "gap": 6,
              "padding": 18,
              "children": [
                {
                  "type": "text",
                  "id": "JsJ6v",
                  "name": "t",
                  "fill": "$fg",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Densest first screen",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-ui",
                  "fontSize": 15,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "AKDSM",
                  "name": "t",
                  "fill": "$fg-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Twelve items fit in the window, where V1 shows four cards in its stream. Today shrinks to one line at the top of the list. The safe verbs (Done, Continue, keep the default, Unblock) stay inline, so most items never need the inspector.",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-ui",
                  "fontSize": 13
                }
              ]
            },
            {
              "type": "frame",
              "id": "s1lmNO",
              "name": "From Apple",
              "width": "fill_container",
              "fill": "$bg",
              "cornerRadius": 12,
              "stroke": "$border",
              "strokeWidth": 1,
              "layout": "vertical",
              "gap": 6,
              "padding": 18,
              "children": [
                {
                  "type": "text",
                  "id": "jkRE4",
                  "name": "t",
                  "fill": "$fg",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The inspector earns its space",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-ui",
                  "fontSize": 15,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "yID3g",
                  "name": "t",
                  "fill": "$fg-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "An approval gets four evidence tiles, the steps that follow Allow, the waiting session with Open session, and a history rail. The action bar is frosted and pinned; J moves to the next hold, and ⌘↵ allows (keydown while Maestro has focus).",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-ui",
                  "fontSize": 13
                }
              ]
            },
            {
              "type": "frame",
              "id": "H44uEF",
              "name": "From Liquid Glass, restrained",
              "width": "fill_container",
              "fill": "$bg",
              "cornerRadius": 12,
              "stroke": "$border",
              "strokeWidth": 1,
              "layout": "vertical",
              "gap": 6,
              "padding": 18,
              "children": [
                {
                  "type": "text",
                  "id": "zIvoa",
                  "name": "t",
                  "fill": "$fg",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Trade-off",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-ui",
                  "fontSize": 15,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "n7VKX5",
                  "name": "t",
                  "fill": "$fg-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Two panes need about 1100 px. Narrower than that, the inspector becomes a pushed page with a back swipe, so the phone gets the list and a detail page, the same pattern as H2. Of the three, this one is furthest from S1's dashboard feel.",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-ui",
                  "fontSize": 13
                }
              ]
            }
          ]
        }
