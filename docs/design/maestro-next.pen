                  "fontFamily": "$font-ui",
                  "fontSize": 16,
                  "fontWeight": "500"
                },
                {
                  "type": "text",
                  "id": "bf8hy",
                  "name": "1  A record that wants a",
                  "fill": "$fg-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "1  A record that wants a human answer is an Ask, never a work item.",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-ui",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "htO3U",
                  "name": "2  No deliverable, no ga",
                  "fill": "$fg-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "2  You never approve the work: gates merge it. An Approval is one exact action a policy layer holds (A0).",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-ui",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "y6wrpA",
                  "name": "3  Every card is bound t",
                  "fill": "$fg-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "3  Every card is bound to its source key; when the source resolves, it closes under Handled for you, with the reason.",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-ui",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "t6kqSB",
                  "name": "4  One server projection",
                  "fill": "$fg-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "4  One server projection, needs.list(kind): header == Σ kinds == Feed sections == push count.",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-ui",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "FC0cc",
                  "name": "5  Writers use verbs on ",
                  "fill": "$fg-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "5  Writers use verbs on maestro.sock; no service writes another service's files.",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-ui",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "M5s4w",
                  "name": "6  An answer returns to ",
                  "fill": "$fg-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "6  An answer returns to the asking session by Paseo agent id; owner-only answers wait for you.",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-ui",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },
