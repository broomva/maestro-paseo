              "name": "Navigation",
              "width": "fill_container",
              "fill": "$bg",
              "cornerRadius": 12,
              "stroke": "$border",
              "strokeWidth": 1,
              "layout": "vertical",
              "gap": 8,
              "padding": [
                16,
                18
              ],
              "children": [
                {
                  "type": "text",
                  "id": "E6nsNZ",
                  "name": "t",
                  "fill": "$fg",
                  "content": "Navigation",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-ui",
                  "fontSize": 15,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "DbAep",
                  "name": "t",
                  "fill": "$fg-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The home is the hold deck: swipe sideways through what needs you, most blocking first (as Decisions sorts). Everything else sits in a sheet at the bottom that you pull up. The title is a menu that moves to Decisions, Work, Health or Initiatives and holds the workspace filter and presence.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "ZZFMx",
              "name": "Strengths",
              "width": "fill_container",
              "fill": "$bg",
              "cornerRadius": 12,
              "stroke": "$border",
              "strokeWidth": 1,
              "layout": "vertical",
              "gap": 8,
              "padding": [
                16,
                18
              ],
              "children": [
                {
                  "type": "text",
                  "id": "ABfo4",
                  "name": "t",
                  "fill": "$fg",
                  "content": "Strengths",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-ui",
                  "fontSize": 15,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "PPTNQ",
                  "name": "t",
                  "fill": "$fg-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Matches why you open Maestro on a phone: a push says something needs you. The verbs are 52 pt and under the thumb: one tap after the app opens. There is no second navigation bar to fight Paseo's chrome.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "rLlDB",
              "name": "Costs and build",
              "width": "fill_container",
              "fill": "$bg",
              "cornerRadius": 12,
              "stroke": "$border",
              "strokeWidth": 1,
              "layout": "vertical",
              "gap": 8,
              "padding": [
                16,
                18
              ],
              "children": [
                {
                  "type": "text",
                  "id": "yFrha",
                  "name": "t",
                  "fill": "$fg",
                  "content": "Costs and build",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-ui",
                  "fontSize": 15,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "WwrVG",
                  "name": "t",
                  "fill": "$fg-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The deck hides how many things are running unless you look at the sheet. A title menu is less discoverable than tabs. Build: the deck and the sheet are our own Views moved by PanResponder and Animated.spring with release velocity (JS thread); Paseo's host sheet can't be used because it is a modal, not a resting peek.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
