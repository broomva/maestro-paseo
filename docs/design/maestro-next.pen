                  "type": "text",
                  "id": "AZDGl",
                  "name": "t",
                  "fill": "#1D1D1F",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "What Liquid Glass buys",
                  "lineHeight": 1.45,
                  "fontFamily": "Inter",
                  "fontSize": 16,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "wWRe6",
                  "name": "t",
                  "fill": "#3C3C43CC",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "·  Feels native on the Mac and iPhone where you already live; zero learning for sheets, sidebars and tab bars",
                  "lineHeight": 1.45,
                  "fontFamily": "Inter",
                  "fontSize": 13
                },
                {
                  "type": "text",
                  "id": "l7MnQE",
                  "name": "t",
                  "fill": "#3C3C43CC",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "·  Chrome separates from content, so the one verb that matters reads first",
                  "lineHeight": 1.45,
                  "fontFamily": "Inter",
                  "fontSize": 13
                },
                {
                  "type": "text",
                  "id": "aJoq1",
                  "name": "t",
                  "fill": "#3C3C43CC",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "·  Push actions and sheets make the one-tap rule literal (B1)",
                  "lineHeight": 1.45,
                  "fontFamily": "Inter",
                  "fontSize": 13
                },
                {
                  "type": "text",
                  "id": "m66y46",
                  "name": "t",
                  "fill": "#3C3C43CC",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "·  Room for presence and lanes in the sidebar, which closes two inventory gaps",
                  "lineHeight": 1.45,
                  "fontFamily": "Inter",
                  "fontSize": 13
                }
              ]
            },
            {
              "type": "frame",
              "id": "OCvTF",
              "name": "What it costs",
              "width": "fill_container",
              "fill": "#FFF4E5",
              "cornerRadius": 16,
              "layout": "vertical",
              "gap": 6,
              "padding": 20,
              "children": [
                {
                  "type": "text",
                  "id": "xEYBw",
                  "name": "t",
                  "fill": "#1D1D1F",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "What it costs",
                  "lineHeight": 1.45,
                  "fontFamily": "Inter",
                  "fontSize": 16,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "CyHkV",
                  "name": "t",
                  "fill": "#3C3C43CC",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "·  Maestro is a Paseo plugin: React on react-native-web, drawn inside Paseo's own frame. Glass only reads right if the frame around it matches",
                  "lineHeight": 1.45,
                  "fontFamily": "Inter",
                  "fontSize": 13
                },
                {
                  "type": "text",
                  "id": "MBqE9",
                  "name": "t",
                  "fill": "#3C3C43CC",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "·  backdrop-filter on every frame costs GPU on a machine already running 20 sessions",
                  "lineHeight": 1.45,
                  "fontFamily": "Inter",
                  "fontSize": 13
                },
                {
                  "type": "text",
                  "id": "n6fE7",
                  "name": "t",
                  "fill": "#3C3C43CC",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "·  The Broomva identity (ink, Tidepool, the Undertow) dissolves into system blue",
                  "lineHeight": 1.45,
                  "fontFamily": "Inter",
                  "fontSize": 13
                },
                {
                  "type": "text",
                  "id": "RWJNr",
                  "name": "t",
                  "fill": "#3C3C43CC",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "·  Legibility over busy content needs vibrancy work on every surface",
                  "lineHeight": 1.45,
                  "fontFamily": "Inter",
                  "fontSize": 13
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "aPbe3",
          "name": "recommendation",
          "width": "fill_container",
          "fill": "#1D1D1F",
