                  "lineHeight": 1.4,
                  "fontFamily": "$font-ui",
                  "fontSize": 15,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "p2m0TG",
                  "name": "t",
                  "fill": "$fg-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Four tabs and New work in a floating bar at the bottom: Feed, Decisions, Work, Health. Initiatives lives in Health and in search. Each tab opens with a large title and its verdict line; the workspace filter is the \"All ▾\" at the end of that line. Pushed pages hide the bar.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "Rkgbe",
              "name": "Strengths",
              "width": "fill_container",
              "fill": "$bg",
              "cornerRadius": 12,
              "stroke": "$border",
              "strokeWidth": 1,
              "layout": "vertical",
              "gap": 8,
              "padding": [
                16,
                18
              ],
              "children": [
                {
                  "type": "text",
                  "id": "U99f4",
                  "name": "t",
                  "fill": "$fg",
                  "content": "Strengths",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-ui",
                  "fontSize": 15,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "F8J3Y",
                  "name": "t",
                  "fill": "$fg-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Every section and New work are under the thumb. It is the pattern iPhone users already know. The large title brings back S1's \"how is it going\" line on every tab, and the carousel keeps all four tiles in one row.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "Kfaa3",
              "name": "Costs and build",
              "width": "fill_container",
              "fill": "$bg",
              "cornerRadius": 12,
              "stroke": "$border",
              "strokeWidth": 1,
              "layout": "vertical",
              "gap": 8,
              "padding": [
                16,
                18
              ],
              "children": [
                {
                  "type": "text",
                  "id": "Gf3eS",
                  "name": "t",
                  "fill": "$fg",
                  "content": "Costs and build",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-ui",
                  "fontSize": 15,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "Ap5rT",
                  "name": "t",
                  "fill": "$fg-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Two navigation systems on one screen: Paseo's header on top, Maestro's bar below; if Paseo ever draws its own bottom chrome inside a plugin screen they collide (unverified). Initiatives loses its tab. Build: an absolute View over the ScrollView; the title collapse is an Animated interpolation of the scroll offset.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-ui",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        }
