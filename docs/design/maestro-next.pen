                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "bf8hy",
                  "name": "1  A record that wants a",
                  "fill": "$fg-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "1  A record that wants a human answer is an Ask, never a work item.",
