                    {
                      "type": "text",
                      "id": "WJIlK",
                      "name": "t",
                      "fill": "$fg",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "How a card behaves",
                      "lineHeight": 1.4,
                      "fontFamily": "$font-ui",
                      "fontSize": 14,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "sYNlo",
                      "name": "t",
                      "fill": "$fg-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "·  Lives in the session that asked: Maestro appends it with timeline.append. The inbox only holds a digest.",
                      "lineHeight": 1.4,
                      "fontFamily": "$font-ui",
                      "fontSize": 12
                    },
                    {
                      "type": "text",
                      "id": "YBBkH",
                      "name": "t",
                      "fill": "$fg-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "·  Carries only {kind, key, version}. The card reads live state by key, so it survives a daemon restart (row data is in memory, ≤ 64 KiB).",
                      "lineHeight": 1.4,
                      "fontFamily": "$font-ui",
                      "fontSize": 12
                    },
                    {
                      "type": "text",
                      "id": "GldZx",
                      "name": "t",
                      "fill": "$fg-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "·  One decision per card: at most two verbs (Copy is a tool, not a verb), plus Open in Maestro. Anything longer opens the session page.",
                      "lineHeight": 1.4,
                      "fontFamily": "$font-ui",
                      "fontSize": 12
                    },
                    {
                      "type": "text",
                      "id": "QFs2C",
                      "name": "t",
                      "fill": "$fg-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "·  Verbs go through plugin RPC (approval.decide, ask.answer), never straight to Paseo: one receipt, one undo.",
                      "lineHeight": 1.4,
                      "fontFamily": "$font-ui",
                      "fontSize": 12
                    },
                    {
                      "type": "text",
                      "id": "Wdn3X",
                      "name": "t",
                      "fill": "$fg-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "·  After acting: 10 s undo in place, then a one-line receipt. Resolved elsewhere: it collapses and says where.",
                      "lineHeight": 1.4,
                      "fontFamily": "$font-ui",
                      "fontSize": 12
                    },
                    {
                      "type": "text",
                      "id": "khfh3",
                      "name": "t",
                      "fill": "$fg-2",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "·  Same card on desktop and phone: React Native primitives only, broomva tokens, no blur.",
                      "lineHeight": 1.4,
                      "fontFamily": "$font-ui",
                      "fontSize": 12
                    }
                  ]
                }
              ]
            }
          ]
        }
