                {
                  "type": "text",
                  "id": "nDZBa",
                  "name": "t",
                  "fill": "$fg-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The card you opened stays lit in the stream (Tidepool, 2 px), so you never lose your place. J and K walk the holds while the inspector stays open; the rail comes back when it closes. Desktop only: on the phone, the inspector is a pushed page.",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-ui",
