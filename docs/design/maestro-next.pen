              "layout": "vertical",
              "gap": 6,
              "padding": 18,
              "children": [
                {
                  "type": "text",
                  "id": "XUFGP",
                  "name": "t",
                  "fill": "$fg",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "What the touch changes",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-ui",
                  "fontSize": 15,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "GbJ12",
                  "name": "t",
                  "fill": "$fg-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "S8's dense table becomes a grouped list where lateness is the loudest thing (warn, bold) and a missing driver reads as a hollow dot. Four tiles say what needs you before you scan. The review is the inspector (J1), so a due review answers like any ask. S8's open question (a Health notice or an Ask on the due date) stays yours: J8 works either way, since both open this inspector.",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-ui",
                  "fontSize": 13
                }
              ]
            },
            {
              "type": "frame",
              "id": "wvEpF",
              "name": "From Liquid Glass, restrained",
              "width": "fill_container",
              "fill": "$bg",
              "cornerRadius": 12,
              "stroke": "$border",
              "strokeWidth": 1,
              "layout": "vertical",
              "gap": 6,
              "padding": 18,
              "children": [
                {
                  "type": "text",
                  "id": "D0qNV",
                  "name": "t",
                  "fill": "$fg",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Plugin build",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-ui",
                  "fontSize": 15,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "FVpAX",
                  "name": "t",
                  "fill": "$fg-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Views and Pressables over .control/initiatives/*.yaml through plugin RPC. Answer writes the review through the same answer path as Decisions (the owner's verb); Open the driver uses openScreen with the driver's agent id. Hanging-off counts link into Work and Decisions with the initiative filter set.",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-ui",
                  "fontSize": 13
                }
              ]
            }
          ]
