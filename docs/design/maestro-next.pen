                  "name": "i",
                  "width": 14,
                  "height": 14,
                  "icon": "corner-down-right",
                  "library": "lucide",
                  "fill": "$needs"
                },
                {
                  "type": "text",
                  "id": "ZODAV",
                  "name": "t",
                  "fill": "$fg-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Drop from H1: Maestro's rows in Paseo's sidebar and the presence footer (the tabs, the workspace filter and presence move into Maestro's top header, and Maestro takes the window), the single column, and implementation tags drawn in the UI (they stay in H3).",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-ui",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
