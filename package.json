{
  "name": "maestro-paseo",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "author": "Carlos D. Escobar-Valbuena <carlosdavidescobar@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/broomva/maestro-paseo.git"
  },
  "bugs": {
    "url": "https://github.com/broomva/maestro-paseo/issues"
  },
  "homepage": "https://github.com/broomva/maestro-paseo#readme",
  "keywords": [
    "paseo",
    "paseo-plugin",
    "agent-orchestration",
    "ai-agents",
    "maestro"
  ],
  "bin": {
    "maestro": "bin/maestro.ts"
  },
  "files": [
    "paseo-plugin.json",
    "bin/",
    "index.client.ts",
    "index.client.tsx",
    "index.server.ts",
    "index.server.tsx",
    "client/",
    "server/",
    "shared/",
    "mcp/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p mcp/tsconfig.json",
    "test": "bun test --timeout 30000",
    "lint": "biome check .",
    "check": "npm run typecheck && npm run lint && npm test",
    "mcp:build": "bun mcp/build.ts",
    "mcp:serve": "bun mcp/server.ts",
    "mcp:preview": "bun mcp/preview.ts --demo",
    "mcp:check": "bun test mcp server/mcp-read-bridge.test.ts && bun run mcp:build",
    "mcp:test:ui": "playwright test -c mcp/playwright.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@getpaseo/client": "0.11.1",
    "@getpaseo/plugin": "0.11.1",
    "@getpaseo/protocol": "0.11.1",
    "@playwright/test": "^1.64.0",
    "@tanstack/react-query": "^5.90.11",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.20.3",
    "@types/react": "~19.2.0",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.25.12",
    "happy-dom": "^20.14.5",
    "lucide-react": "^1.55.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "0.21.2",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "description": "Maestro on Paseo: work as folders, sessions as the verb, the gate as the human verb",
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "yaml": "^2.9.1"
  }
}
